    "max_same_country_best50": 15,
    "max_same_country_best100": 25
  },
  "history": {
    "file": "output/history.json",
    "max_latency_samples": 20,
    "decay_days": 14,
    "max_nodes": 5000,
    "retention_days": 14,
    "max_file_bytes": 20000000
  },
